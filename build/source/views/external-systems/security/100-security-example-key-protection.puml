@startuml
title <size:24>Container - Example: Entra-authenticated HSM signing and key wrapping</size>\n<size:24>Container - Example: Entra-authenticated HSM signing and key wrapping</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("MicrosoftEntraID_boundary", "Microsoft Entra ID", $tags="") {
  Container(MicrosoftEntraID.Authenticationandtokenservice, "Authentication and token service", $techn="Microsoft Entra managed service (logical)", $descr="Logical identity-platform service for user and application authentication and token issuance.", $tags="", $link="https://learn.microsoft.com/en-us/entra/identity-platform/v2-protocols-oidc")
}

System_Boundary("Memberapplicationreference_boundary", "Member application reference", $tags="") {
  Container(Memberapplicationreference.Memberbusinessapplication, "Member business application", $techn="Example application / REST client", $descr="Submits requests and consumes acknowledged FireFly events.", $tags="", $link="https://hyperledger-firefly.github.io/firefly/head/architecture/node_component_architecture/")
}

System_Boundary("AzureManagedHSM_boundary", "Azure Managed HSM", $tags="") {
  ContainerDb(AzureManagedHSM.HSMprotectedkeystorage, "HSM-protected key storage", $techn="HSM-protected managed storage (logical)", $descr="Logical protected store for non-exportable example private keys, key versions and local role data; not a separate database server.", $tags="", $link="https://learn.microsoft.com/en-us/azure/key-vault/managed-hsm/about-keys-details")
  Container(AzureManagedHSM.ManagedHSMdataplaneservice, "Managed HSM data-plane service", $techn="Azure Managed HSM / HTTPS API", $descr="Logical managed-service boundary for key operations and local role assignments; physical HSM topology is excluded.", $tags="", $link="https://learn.microsoft.com/en-us/azure/key-vault/managed-hsm/access-control")
}

Rel(MicrosoftEntraID.Authenticationandtokenservice, Memberapplicationreference.Memberbusinessapplication, "Returns HSM-audience workload access token", $techn="HTTPS / OAuth 2.0 token response", $tags="", $link="")
Rel(AzureManagedHSM.ManagedHSMdataplaneservice, Memberapplicationreference.Memberbusinessapplication, "Returns signature or wrapped data key; never the HSM private key", $techn="HTTPS / Managed HSM REST response", $tags="", $link="")
Rel(AzureManagedHSM.ManagedHSMdataplaneservice, MicrosoftEntraID.Authenticationandtokenservice, "Retrieves issuer metadata and public signing keys for cached token verification", $techn="HTTPS / OpenID metadata and JWKS", $tags="", $link="")
Rel(AzureManagedHSM.ManagedHSMdataplaneservice, AzureManagedHSM.HSMprotectedkeystorage, "Creates or updates protected keys, versions and local role records", $techn="Protected managed-service storage interface", $tags="", $link="")
Rel(AzureManagedHSM.ManagedHSMdataplaneservice, AzureManagedHSM.HSMprotectedkeystorage, "Invokes signing or key-wrapping operation through a protected key handle", $techn="Protected cryptographic interface (logical)", $tags="", $link="")
Rel(AzureManagedHSM.HSMprotectedkeystorage, AzureManagedHSM.ManagedHSMdataplaneservice, "Returns cryptographic result without private key material", $techn="Protected cryptographic interface (logical)", $tags="", $link="")
Rel(Memberapplicationreference.Memberbusinessapplication, AzureManagedHSM.ManagedHSMdataplaneservice, "Submits bearer token, key identifier and digest or key-wrapping input", $techn="HTTPS / Managed HSM REST API", $tags="", $link="")
Rel(Memberapplicationreference.Memberbusinessapplication, MicrosoftEntraID.Authenticationandtokenservice, "Authenticates workload identity and requests HSM-audience access token", $techn="HTTPS / OAuth 2.0 client credentials", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml