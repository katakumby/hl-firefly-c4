@startuml
title <size:24>Container View: Example System</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("ExampleSystem_boundary", "Example System", $tags="") {
  Container(ExampleSystem.API, "API", $techn="", $descr="The API container for the example system.", $tags="", $link="")
  Container(ExampleSystem.Backend, "Backend", $techn="", $descr="The backend container for the example system.", $tags="", $link="")
}

Rel(ExampleSystem.API, ExampleSystem.Backend, "Handles API requests and responses", $techn="", $tags="", $link="")
Rel(ExampleSystem.Backend, ExampleSystem.API, "Sends responses back to the API", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml