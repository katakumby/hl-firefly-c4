@startuml
title <size:24>Component - FireFly configuration migrator</size>\n<size:24>Component - FireFly configuration migrator</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

Person(Applicationdeveloper, "Application developer", $descr="Builds and tests member business integrations.", $tags="", $link="https://hyperledger-firefly.github.io/firefly/head/architecture/node_component_architecture/")

System_Boundary("FireFlydevelopertools_boundary", "FireFly developer tools", $tags="") {
  Container_Boundary("FireFlydevelopertools.FireFlyconfigurationmigrator_boundary", "FireFly configuration migrator", $tags="") {
    Component(FireFlydevelopertools.FireFlyconfigurationmigrator.ConfigurationCLI, "Configuration CLI", $techn="Go", $descr="Reads input configuration and requested versions.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/ffconfig/main.go")
    Component(FireFlydevelopertools.FireFlyconfigurationmigrator.Configurationmigrations, "Configuration migrations", $techn="Go", $descr="Transforms configuration to the selected schema version.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/ffconfig/migrate")
  }

}

Rel(Applicationdeveloper, FireFlydevelopertools.FireFlyconfigurationmigrator.ConfigurationCLI, "Supplies configuration and target version", $techn="CLI / file input", $tags="", $link="")
Rel(FireFlydevelopertools.FireFlyconfigurationmigrator.Configurationmigrations, Applicationdeveloper, "Writes migrated configuration for review", $techn="YAML / standard output", $tags="", $link="")
Rel(FireFlydevelopertools.FireFlyconfigurationmigrator.ConfigurationCLI, FireFlydevelopertools.FireFlyconfigurationmigrator.Configurationmigrations, "Submits parsed configuration for migration", $techn="In-process calls / Go", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml