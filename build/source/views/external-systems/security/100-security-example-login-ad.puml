@startuml
title <size:24>Container - Example: Keycloak login with AD LDAP</size>\n<size:24>Container - Example: Keycloak login with AD LDAP</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Businessuser, "Business user", $descr="Submits consortium business actions through a member application.", $tags="", $link="https://hyperledger-firefly.github.io/firefly/head/architecture/node_component_architecture/")

System_Boundary("Memberapplicationreference_boundary", "Member application reference", $tags="") {
  Container(Memberapplicationreference.Memberbusinessapplication, "Member business application", $techn="Example application / REST client", $descr="Submits requests and consumes acknowledged FireFly events.", $tags="", $link="https://hyperledger-firefly.github.io/firefly/head/architecture/node_component_architecture/")
}

System_Boundary("MicrosoftActiveDirectoryDomainServices_boundary", "Microsoft Active Directory Domain Services", $tags="") {
  Container(MicrosoftActiveDirectoryDomainServices.Domaincontrollerservices, "Domain-controller services", $techn="Windows Server / AD DS", $descr="Logical AD DS runtime; no server instances, sites or replication topology are modeled.", $tags="", $link="https://learn.microsoft.com/en-us/windows-server/identity/ad-ds/get-started/virtual-dc/active-directory-domain-services-overview")
}

System_Boundary("Keycloak_boundary", "Keycloak", $tags="") {
  Container(Keycloak.Keycloakserver, "Keycloak server", $techn="Java / Keycloak", $descr="Hosts login, administration, federation and protocol services; cache is embedded.", $tags="", $link="https://www.keycloak.org/docs/latest/server_admin/index.html")
}

Rel(Keycloak.Keycloakserver, MicrosoftActiveDirectoryDomainServices.Domaincontrollerservices, "Queries user attributes and validates supplied credentials by LDAP bind", $techn="LDAPS", $tags="", $link="")
Rel(Keycloak.Keycloakserver, Memberapplicationreference.Memberbusinessapplication, "Returns authenticated identity tokens or assertions through the selected protocol flow", $techn="HTTPS / OIDC reference client", $tags="", $link="")
Rel(Businessuser, Memberapplicationreference.Memberbusinessapplication, "Submits business actions", $techn="HTTPS", $tags="", $link="")
Rel(Businessuser, Keycloak.Keycloakserver, "Submits sign-in interaction through the user browser", $techn="HTTPS / browser OIDC", $tags="", $link="")
Rel(Businessuser, MicrosoftActiveDirectoryDomainServices.Domaincontrollerservices, "Requests domain sign-in and service tickets through the domain client", $techn="Kerberos / domain client", $tags="", $link="")
Rel(MicrosoftActiveDirectoryDomainServices.Domaincontrollerservices, Keycloak.Keycloakserver, "Returns user attributes and bind result; does not export passwords", $techn="LDAPS", $tags="", $link="")
Rel(MicrosoftActiveDirectoryDomainServices.Domaincontrollerservices, Businessuser, "Returns Kerberos ticket response to the domain client", $techn="Kerberos / domain client", $tags="", $link="")
Rel(Memberapplicationreference.Memberbusinessapplication, Keycloak.Keycloakserver, "Submits authorization request via browser and configured protocol client", $techn="HTTPS / OIDC reference client", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml