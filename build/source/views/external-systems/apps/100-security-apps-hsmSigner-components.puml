    Component(Memberapplicationreference.ProposedHSMsigningadapter.Transactionpreparation, "Transaction preparation", $techn="Custom integration responsibility / implementation required", $descr="Proposed reference: Prepares chain-aware Ethereum signing payloads and Keccak-256 digests; preserves supplied transaction fields.", $tags="", $link="https://ethereum.org/en/developers/docs/transactions/")
    Component(Memberapplicationreference.ProposedHSMsigningadapter.HSMaccessclient, "HSM access client", $techn="Custom integration responsibility / implementation required", $descr="Proposed reference: Acquires an Entra application token and requests signing with the selected non-exportable secp256k1 key.", $tags="", $link="https://ethereum.org/en/developers/docs/transactions/")
