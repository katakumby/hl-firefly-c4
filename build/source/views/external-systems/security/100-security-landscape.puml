Rel(Securityadministrator, AzureResourceManager, "Submits Managed HSM resource administration request", $techn="HTTPS / Azure Resource Manager API", $tags="", $link="")
Rel(MicrosoftActiveDirectoryDomainServices, Keycloak, "Returns user attributes and credential validation outcome", $techn="LDAPS", $tags="", $link="")
Rel(MicrosoftActiveDirectoryDomainServices, MicrosoftActiveDirectoryFederationServices, "Returns domain authentication result and account attributes", $techn="Kerberos / protected directory access", $tags="", $link="")
Rel(MicrosoftActiveDirectoryDomainServices, MicrosoftEntraID, "Returns selected identity attributes for Cloud Sync provisioning", $techn="Protected LDAP / agent-established TLS service channel", $tags="", $link="")
Rel(MicrosoftActiveDirectoryDomainServices, Businessuser, "Returns Kerberos ticket response to the domain client", $techn="Kerberos", $tags="", $link="")
Rel(MicrosoftActiveDirectoryFederationServices, Memberapplicationreference, "Returns identity tokens or assertions for application access", $techn="HTTPS / configured identity protocol", $tags="", $link="")
