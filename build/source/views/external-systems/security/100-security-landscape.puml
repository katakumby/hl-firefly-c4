@startuml
title <size:24>System Landscape - Security product reference catalog</size>\n<size:24>System Landscape - Security product reference catalog</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

AddBoundaryTag("Azure cryptographic services", $borderColor="#444444", $fontColor="#444444", $borderStyle="dashed")
Boundary(group_1, "Azure cryptographic services", $tags="Azure cryptographic services") {
  System(AzureResourceManager, "Azure Resource Manager", $descr="External management-plane boundary; applies Azure RBAC to Managed HSM resource administration, not key operations.", $tags="", $link="https://learn.microsoft.com/en-us/azure/key-vault/managed-hsm/access-control")
  System(AzureManagedHSM, "Azure Managed HSM", $descr="Protects cryptographic keys and performs authorized cryptographic operations; not a general secret or certificate store.", $tags="", $link="https://learn.microsoft.com/en-us/azure/key-vault/managed-hsm/access-control")
}

AddBoundaryTag("Identity and federation", $borderColor="#444444", $fontColor="#444444", $borderStyle="dashed")
Boundary(group_2, "Identity and federation", $tags="Identity and federation") {
  System(MicrosoftEntraID, "Microsoft Entra ID", $descr="Cloud identity, token issuance, directory administration and provisioning; separate from AD DS and AD FS.", $tags="", $link="https://learn.microsoft.com/en-us/entra/architecture/architecture")
  System(MicrosoftActiveDirectoryFederationServices, "Microsoft Active Directory Federation Services", $descr="Federates AD-backed identities and issues claims to relying parties; separate from directory synchronization.", $tags="", $link="https://learn.microsoft.com/en-us/windows-server/identity/ad-fs/ad-fs-overview")
  System(MicrosoftActiveDirectoryDomainServices, "Microsoft Active Directory Domain Services", $descr="Directory identities, LDAP queries and Kerberos authentication for the enterprise domain.", $tags="", $link="https://learn.microsoft.com/en-us/windows-server/identity/ad-ds/get-started/virtual-dc/active-directory-domain-services-overview")
  System(Keycloak, "Keycloak", $descr="Identity and access management: SSO, federation, brokering and token issuance.", $tags="", $link="https://www.keycloak.org/docs/latest/server_admin/index.html")
}

AddBoundaryTag("Privileged access and secrets", $borderColor="#444444", $fontColor="#444444", $borderStyle="dashed")
Boundary(group_3, "Privileged access and secrets", $tags="Privileged access and secrets") {
  System(CyberArkConjurEnterprise, "CyberArk Conjur Enterprise", $descr="Enterprise workload secret access; documented as Secrets Manager Self-Hosted. OSS is not the selected variant.", $tags="", $link="https://docs.cyberark.com/secrets-manager-sh/latest/en/content/resources/_topnav/cc_home.htm")
  System(CyberArkPAMSelfHosted, "CyberArk PAM Self-Hosted", $descr="Controls privileged credentials, password rotation and recorded administrative sessions.", $tags="", $link="https://docs.cyberark.com/pam-self-hosted/latest/en/content/pas%20inst/installationoverview.htm")
}

Person(Consortiumoperator, "Consortium operator", $descr="Operates member namespaces, recovery and the Besu network.", $tags="", $link="https://hyperledger-firefly.github.io/firefly/head/architecture/node_component_architecture/")
Person(Businessuser, "Business user", $descr="Submits consortium business actions through a member application.", $tags="", $link="https://hyperledger-firefly.github.io/firefly/head/architecture/node_component_architecture/")
Person(Securityadministrator, "Security administrator", $descr="Configures identity, privileged access, secret policies and key permissions in these reference examples.", $tags="", $link="https://docs.cyberark.com/pam-self-hosted/latest/en/content/pas%20inst/installationoverview.htm")
System(Memberapplicationreference, "Member application reference", $descr="One example member application boundary; unrelated member applications are not implied to share ownership.", $tags="", $link="https://hyperledger-firefly.github.io/firefly/head/architecture/node_component_architecture/")
System(Managedtargetsystem, "Managed target system", $descr="Example SSH-accessible administrative target whose privileged account is rotated and sessions are controlled by PAM.", $tags="", $link="https://docs.cyberark.com/pam-self-hosted/latest/en/content/pas%20inst/installationoverview.htm")

Rel(CyberArkPAMSelfHosted, Managedtargetsystem, "Rotates target credentials and brokers recorded privileged sessions", $techn="SSH / target-specific password commands", $tags="", $link="")
Rel(CyberArkPAMSelfHosted, Consortiumoperator, "Returns brokered session output and completion status", $techn="Encrypted session client", $tags="", $link="")
