@startuml
title <size:24>Component - FireFly Core: Inbound sequencing and event delivery</size>\n<size:24>Component - FireFly Core: Inbound sequencing and event delivery</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("HyperledgerFireFly_boundary", "Hyperledger FireFly", $tags="") {
  Container_Boundary("HyperledgerFireFly.FireFlyCore_boundary", "FireFly Core", $tags="") {
    Component(HyperledgerFireFly.FireFlyCore.Shareddownloadmanager, "Shared download manager", $techn="Go", $descr="Retrieves referenced broadcast batches and blobs.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/shareddownload")
    Component(HyperledgerFireFly.FireFlyCore.Inboundeventaggregator, "Inbound event aggregator", $techn="Go", $descr="Correlates ledger pins with payloads and sequences confirmed messages.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/events/aggregator.go")
    Component(HyperledgerFireFly.FireFlyCore.Subscriptionmanager, "Subscription manager", $techn="Go", $descr="Filters events and persists subscriber offsets.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/events/subscription_manager.go")
    Component(HyperledgerFireFly.FireFlyCore.Eventdispatcher, "Event dispatcher", $techn="Go", $descr="Delivers ordered event batches and processes acknowledgements.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/events/event_dispatcher.go")
    Component(HyperledgerFireFly.FireFlyCore.Syncasyncbridge, "Sync/async bridge", $techn="Go", $descr="Correlates asynchronous completion with waiting API requests.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/syncasync")
    Component(HyperledgerFireFly.FireFlyCore.Blockchainplugin, "Blockchain plugin", $techn="Go", $descr="Defines blockchain operations and dispatches to the configured chain adapter.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/blockchain")
    Component(HyperledgerFireFly.FireFlyCore.Databaseplugin, "Database plugin", $techn="Go", $descr="Defines transactional persistence and dispatches to the selected SQL adapter.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/database")
    Component(HyperledgerFireFly.FireFlyCore.Dataexchangeplugin, "Data exchange plugin", $techn="Go", $descr="Binds message, blob and peer operations to the HTTPS connector.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/dataexchange")
    Component(HyperledgerFireFly.FireFlyCore.Tokenplugin, "Token plugin", $techn="Go", $descr="Binds standard token operations to remote token connectors.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/tokens")
    Component(HyperledgerFireFly.FireFlyCore.Eventtransportinterface, "Event transport interface", $techn="Go", $descr="Binds subscriber delivery to a configured event transport.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/events")
  }

}

Rel(HyperledgerFireFly.FireFlyCore.Eventtransportinterface, Memberapplicationreference.Memberbusinessapplication, "Delivers events through configured transports", $techn="WebSocket / webhook / HTTPS", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore.Blockchainplugin, HyperledgerFireFly.FireFlyCore.Inboundeventaggregator, "Delivers confirmed ledger events", $techn="In-process calls / Go", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore.Dataexchangeplugin, HyperledgerFireFly.FireFlyCore.Inboundeventaggregator, "Delivers received payload notifications", $techn="In-process calls / Go", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore.Tokenplugin, HyperledgerFireFly.FireFlyCore.Inboundeventaggregator, "Delivers token creation and transfer events", $techn="In-process calls / Go", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore.Inboundeventaggregator, HyperledgerFireFly.FireFlyCore.Shareddownloadmanager, "Requests missing shared data", $techn="In-process calls / Go", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore.Inboundeventaggregator, HyperledgerFireFly.FireFlyCore.Databaseplugin, "Persists sequenced events and message state", $techn="In-process calls / Go", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore.Inboundeventaggregator, HyperledgerFireFly.FireFlyCore.Subscriptionmanager, "Publishes locally ordered events", $techn="In-process calls / Go", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore.Subscriptionmanager, HyperledgerFireFly.FireFlyCore.Databaseplugin, "Persists subscriptions and acknowledged offsets", $techn="In-process calls / Go", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore.Subscriptionmanager, HyperledgerFireFly.FireFlyCore.Eventdispatcher, "Dispatches filtered event batches", $techn="In-process calls / Go", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore.Eventdispatcher, HyperledgerFireFly.FireFlyCore.Eventtransportinterface, "Delivers events via configured transports", $techn="In-process calls / Go", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore.Eventdispatcher, HyperledgerFireFly.FireFlyCore.Syncasyncbridge, "Completes waiting requests", $techn="In-process calls / Go", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml