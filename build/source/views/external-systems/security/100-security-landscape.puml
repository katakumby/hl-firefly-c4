Rel(AzureManagedHSM, MicrosoftEntraID, "Retrieves issuer metadata and public signing keys for caller token verification", $techn="HTTPS / OpenID metadata and JWKS", $tags="", $link="")
Rel(Managedtargetsystem, CyberArkPAMSelfHosted, "Returns password-operation outcomes and privileged session output", $techn="SSH / target command response", $tags="", $link="")
