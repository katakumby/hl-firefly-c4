@startuml
title <size:24>System Context - Azure Managed HSM reference</size>\n<size:24>System Context - Azure Managed HSM reference</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

AddBoundaryTag("Azure cryptographic services", $borderColor="#444444", $fontColor="#444444", $borderStyle="dashed")
Boundary(group_1, "Azure cryptographic services", $tags="Azure cryptographic services") {
  System(AzureResourceManager, "Azure Resource Manager", $descr="External management-plane boundary; applies Azure RBAC to Managed HSM resource administration, not key operations.", $tags="", $link="https://learn.microsoft.com/en-us/azure/key-vault/managed-hsm/access-control")
  System(AzureManagedHSM, "Azure Managed HSM", $descr="Protects cryptographic keys and performs authorized cryptographic operations; not a general secret or certificate store.", $tags="", $link="https://learn.microsoft.com/en-us/azure/key-vault/managed-hsm/access-control")
}

AddBoundaryTag("Identity and federation", $borderColor="#444444", $fontColor="#444444", $borderStyle="dashed")
Boundary(group_2, "Identity and federation", $tags="Identity and federation") {
  System(MicrosoftEntraID, "Microsoft Entra ID", $descr="Cloud identity, token issuance, directory administration and provisioning; separate from AD DS and AD FS.", $tags="", $link="https://learn.microsoft.com/en-us/entra/architecture/architecture")
}

Person(Securityadministrator, "Security administrator", $descr="Configures identity, privileged access, secret policies and key permissions in these reference examples.", $tags="", $link="https://docs.cyberark.com/pam-self-hosted/latest/en/content/pas%20inst/installationoverview.htm")
System(Memberapplicationreference, "Member application reference", $descr="One example member application boundary; unrelated member applications are not implied to share ownership.", $tags="", $link="https://hyperledger-firefly.github.io/firefly/head/architecture/node_component_architecture/")

Rel(MicrosoftEntraID, Memberapplicationreference, "Returns identity tokens or assertions for application access", $techn="HTTPS / configured identity protocol", $tags="", $link="")
Rel(AzureManagedHSM, Memberapplicationreference, "Returns signature or wrapped key result without private key material", $techn="HTTPS / Managed HSM REST response", $tags="", $link="")
Rel(AzureManagedHSM, MicrosoftEntraID, "Retrieves issuer metadata and public signing keys for caller token verification", $techn="HTTPS / OpenID metadata and JWKS", $tags="", $link="")
Rel(Securityadministrator, AzureManagedHSM, "Configures Azure Managed HSM access policy and reviews administrative outcomes", $techn="HTTPS / product administration interface", $tags="", $link="")
Rel(Securityadministrator, MicrosoftEntraID, "Configures Microsoft Entra ID access policy and reviews administrative outcomes", $techn="HTTPS / product administration interface", $tags="", $link="")
Rel(Securityadministrator, AzureResourceManager, "Submits Managed HSM resource administration request", $techn="HTTPS / Azure Resource Manager API", $tags="", $link="")
Rel(Memberapplicationreference, MicrosoftEntraID, "Requests application sign-in and identity claims", $techn="HTTPS / OIDC or SAML reference flow", $tags="", $link="")
Rel(Memberapplicationreference, AzureManagedHSM, "Submits authorized signing or key-wrapping request", $techn="HTTPS / Managed HSM REST API", $tags="", $link="")
Rel(AzureResourceManager, AzureManagedHSM, "Applies resource-management changes authorized by Azure RBAC; does not grant key access", $techn="Azure management-plane interface", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml