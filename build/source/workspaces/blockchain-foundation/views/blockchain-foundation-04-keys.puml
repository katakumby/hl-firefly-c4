@startuml
title <size:24>04 - Key and signing deployment - separate validator and transaction keys</size>\n<size:24>V1 represents six independent validator keys. Transaction gateways use Azure Key Vault Premium. Validator HSM compatibility and AZ isolation are unresolved gate H1; custom signing integration is gate H2.</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(ProductionthreeAZ.Azureregionselectionpending, "Azure region - selection pending", $type="Microsoft Azure", $descr="One region with three AZs and qualified service SKUs. HSM zone resilience remains admission gate H1.", $tags="", $link="") {
  Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.RegionalnetworkingandAKScontrol, "Regional networking and AKS control", $type="Azure VNet / private AKS Standard", $descr="VNet and subnets span zones; Azure subnets are not zonal.", $tags="", $link="") {
    Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.RegionalnetworkingandAKScontrol.BesuRPCroutingservice, "Besu RPC routing service", $type="ClusterIP / session-aware JSON-RPC proxy", $descr="Three proxy replicas, one per AZ. Pin connector filter sessions to one healthy backend; rebuild filters after failover.", $tags="", $link="")
  }

  Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember, "Private AKS cluster - one member", $type="AKS Standard / Azure CNI Overlay + Cilium", $descr="System, ledger and middleware pools; explicit zonal capacity and separate Kubernetes namespaces.", $tags="", $link="") {
    Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1, "Availability Zone 1", $type="Azure AZ 1", $descr="Independent power, cooling and network failure domain.", $tags="", $link="") {
      Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.LedgerpoolAZ1, "Ledger pool - AZ1", $type="AKS user pool", $descr="Three separate hosts: two validators and one RPC node. No Spot; no automatic validator scaling.", $tags="", $link="") {
        Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.LedgerpoolAZ1.ValidatorV1pod, "Validator V1 pod", $type="StatefulSet / Besu security-module plugin", $descr="Unique node identity; dedicated RWO Premium SSD LRS PVC. Pin to AZ1; lost-zone volumes are not on the surviving write path.", $tags="", $link="") {
          Container(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.LedgerpoolAZ1.ValidatorV1pod.Besunode_1, "Besu node", $techn="Java / Besu / RocksDB", $descr="Runs the selected validator or non-validator RPC/discovery role; each instance owns its key and ledger.", $tags="", $link="https://github.com/besu-eth/besu/tree/7e05c2342404d27bd06a992e336c5e0c86a5d8d1")
        }

      }

      Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1, "Middleware pool - AZ1", $type="AKS user pool", $descr="Separate taint and namespace. mTLS gateway, RPC proxy and stateless signer have one replica per zone.", $tags="", $link="") {
        Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.Signinggatewayreplica1, "Signing gateway replica 1", $type="Deployment / one replica per AZ", $descr="Stateless transaction signing only; the connector owns nonces.", $tags="", $link="") {
          Container(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.Signinggatewayreplica1.EthereumHSMsigninggateway_1, "Ethereum HSM signing gateway", $techn="Ethereum JSON-RPC / Azure Key Vault Premium REST", $descr="Custom integration: signs supplied nonces with member transaction keys, normalizes signatures and forwards raw transactions. Does not allocate nonces.", $tags="", $link="")
        }

        Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.RecoverycontrollercandidateAZ1, "Recovery controller candidate - AZ1", $type="Deployment / one replica per AZ", $descr="One of three candidates; only the elected leader coordinates recovery. Gate F1.", $tags="", $link="") {
          Container(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.RecoverycontrollercandidateAZ1.Fencedrecoverycontroller_1, "Fenced recovery controller", $techn="Kubernetes API / Azure Compute API / Workload Identity", $descr="Proposed automation: confirms old VM termination before replacing singleton member workers or reusing a validator identity.", $tags="", $link="")
        }

        Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.MemberAactiverecoveryunit, "Member A - active recovery unit", $type="Singleton StatefulSet / replicas 1", $descr="One active pod, four product containers. Baseline moves this unit after fencing; no unqualified active-active workers.", $tags="", $link="") {
          Container(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.MemberAactiverecoveryunit.EVMConnectFFTM_1, "EVMConnect + FFTM", $techn="Go", $descr="Submits Ethereum transactions and streams confirmed events; one nonce writer.", $tags="", $link="https://github.com/hyperledger-firefly/evmconnect/tree/6e12bb4c050677780cf5dd975a926923868b0cb8/cmd/evmconnect.go")
        }

      }

    }

    Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2, "Availability Zone 2", $type="Azure AZ 2", $descr="Independent power, cooling and network failure domain.", $tags="", $link="") {
      Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2.MiddlewarepoolAZ2, "Middleware pool - AZ2", $type="AKS user pool", $descr="Separate taint and namespace. mTLS gateway, RPC proxy and stateless signer have one replica per zone.", $tags="", $link="") {
        Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2.MiddlewarepoolAZ2.Signinggatewayreplica2, "Signing gateway replica 2", $type="Deployment / one replica per AZ", $descr="Stateless transaction signing only; the connector owns nonces.", $tags="", $link="") {
          Container(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2.MiddlewarepoolAZ2.Signinggatewayreplica2.EthereumHSMsigninggateway_1, "Ethereum HSM signing gateway", $techn="Ethereum JSON-RPC / Azure Key Vault Premium REST", $descr="Custom integration: signs supplied nonces with member transaction keys, normalizes signatures and forwards raw transactions. Does not allocate nonces.", $tags="", $link="")
        }

        Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2.MiddlewarepoolAZ2.RecoverycontrollercandidateAZ2, "Recovery controller candidate - AZ2", $type="Deployment / one replica per AZ", $descr="One of three candidates; only the elected leader coordinates recovery. Gate F1.", $tags="", $link="") {
          Container(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2.MiddlewarepoolAZ2.RecoverycontrollercandidateAZ2.Fencedrecoverycontroller_1, "Fenced recovery controller", $techn="Kubernetes API / Azure Compute API / Workload Identity", $descr="Proposed automation: confirms old VM termination before replacing singleton member workers or reusing a validator identity.", $tags="", $link="")
        }

      }

    }

    Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3, "Availability Zone 3", $type="Azure AZ 3", $descr="Independent power, cooling and network failure domain.", $tags="", $link="") {
      Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3.MiddlewarepoolAZ3, "Middleware pool - AZ3", $type="AKS user pool", $descr="Separate taint and namespace. mTLS gateway, RPC proxy and stateless signer have one replica per zone.", $tags="", $link="") {
        Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3.MiddlewarepoolAZ3.Signinggatewayreplica3, "Signing gateway replica 3", $type="Deployment / one replica per AZ", $descr="Stateless transaction signing only; the connector owns nonces.", $tags="", $link="") {
          Container(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3.MiddlewarepoolAZ3.Signinggatewayreplica3.EthereumHSMsigninggateway_1, "Ethereum HSM signing gateway", $techn="Ethereum JSON-RPC / Azure Key Vault Premium REST", $descr="Custom integration: signs supplied nonces with member transaction keys, normalizes signatures and forwards raw transactions. Does not allocate nonces.", $tags="", $link="")
        }

        Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3.MiddlewarepoolAZ3.RecoverycontrollercandidateAZ3, "Recovery controller candidate - AZ3", $type="Deployment / one replica per AZ", $descr="One of three candidates; only the elected leader coordinates recovery. Gate F1.", $tags="", $link="") {
          Container(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3.MiddlewarepoolAZ3.RecoverycontrollercandidateAZ3.Fencedrecoverycontroller_1, "Fenced recovery controller", $techn="Kubernetes API / Azure Compute API / Workload Identity", $descr="Proposed automation: confirms old VM termination before replacing singleton member workers or reusing a validator identity.", $tags="", $link="")
        }

      }

    }

  }

  Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.ManagedpersistenceoutsideAKS, "Managed persistence - outside AKS", $type="Azure data services", $descr="Azure-managed resources; ZRS disks are region-scoped. Database engines occupy two AZs.", $tags="", $link="") {
    Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.ManagedpersistenceoutsideAKS.Protectedrecoverystorage, "Protected recovery storage", $type="Azure Blob / Backup / snapshots", $descr="Blob ZRS backups plus database PITR; versioned genesis, configs, volume snapshots and HSM recovery material under separate access.", $tags="", $link="")
  }

  Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS, "Azure key services - outside AKS", $type="Azure HSM services / Entra", $descr="Separate validator, transaction and TLS/secrets key domains.", $tags="", $link="") {
    Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.ValidatorHSMclusterGATEH1, "Validator HSM cluster - GATE H1", $type="Candidate Azure Cloud HSM / PKCS#11", $descr="Azure Cloud HSM candidate: three service nodes, AZ placement NOT established. Require secp256k1 signing + ECDH, PKCS#11 and AZ-outage proof.", $tags="", $link="")
    Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.KeyVaultPremium, "Key Vault Premium", $type="Azure Key Vault Premium / HTTPS", $descr="AZ-redundant in a supported region. EC-HSM transaction keys; separate secrets/certificates vault. Private endpoints and least-privilege roles.", $tags="", $link="")
    Deployment_Node(ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.MicrosoftEntraID, "Microsoft Entra ID", $type="AKS OIDC / Workload Identity", $descr="Federates AKS service-account tokens; authorizes Key Vault and scoped Azure recovery operations. No Keycloak.", $tags="", $link="")
  }

}

Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.MemberAactiverecoveryunit.EVMConnectFFTM_1, ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.Signinggatewayreplica1.EthereumHSMsigninggateway_1, "Sends nonce-assigned transactions and pinned RPC sessions", $techn="JSON-RPC / mTLS ClusterIP", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.MemberAactiverecoveryunit.EVMConnectFFTM_1, ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2.MiddlewarepoolAZ2.Signinggatewayreplica2.EthereumHSMsigninggateway_1, "Sends nonce-assigned transactions and pinned RPC sessions", $techn="JSON-RPC / mTLS ClusterIP", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.MemberAactiverecoveryunit.EVMConnectFFTM_1, ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3.MiddlewarepoolAZ3.Signinggatewayreplica3.EthereumHSMsigninggateway_1, "Sends nonce-assigned transactions and pinned RPC sessions", $techn="JSON-RPC / mTLS ClusterIP", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.LedgerpoolAZ1.ValidatorV1pod.Besunode_1, ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.ValidatorHSMclusterGATEH1, "Signs QBFT payloads and performs node-key ECDH with key V1", $techn="PKCS#11 / vendor encrypted channel", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.Signinggatewayreplica1.EthereumHSMsigninggateway_1, ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.KeyVaultPremium, "Signs Ethereum digests with allowed EC-HSM transaction keys", $techn="HTTPS 443 / digest signing", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.Signinggatewayreplica1.EthereumHSMsigninggateway_1, ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.MicrosoftEntraID, "Exchanges its projected service-account token", $techn="OIDC / OAuth2 over HTTPS", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.Signinggatewayreplica1.EthereumHSMsigninggateway_1, ProductionthreeAZ.Azureregionselectionpending.RegionalnetworkingandAKScontrol.BesuRPCroutingservice, "Forwards reads and submits eth_sendRawTransaction", $techn="JSON-RPC / private TLS", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2.MiddlewarepoolAZ2.Signinggatewayreplica2.EthereumHSMsigninggateway_1, ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.KeyVaultPremium, "Signs Ethereum digests with allowed EC-HSM transaction keys", $techn="HTTPS 443 / digest signing", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2.MiddlewarepoolAZ2.Signinggatewayreplica2.EthereumHSMsigninggateway_1, ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.MicrosoftEntraID, "Exchanges its projected service-account token", $techn="OIDC / OAuth2 over HTTPS", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2.MiddlewarepoolAZ2.Signinggatewayreplica2.EthereumHSMsigninggateway_1, ProductionthreeAZ.Azureregionselectionpending.RegionalnetworkingandAKScontrol.BesuRPCroutingservice, "Forwards reads and submits eth_sendRawTransaction", $techn="JSON-RPC / private TLS", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3.MiddlewarepoolAZ3.Signinggatewayreplica3.EthereumHSMsigninggateway_1, ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.KeyVaultPremium, "Signs Ethereum digests with allowed EC-HSM transaction keys", $techn="HTTPS 443 / digest signing", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3.MiddlewarepoolAZ3.Signinggatewayreplica3.EthereumHSMsigninggateway_1, ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.MicrosoftEntraID, "Exchanges its projected service-account token", $techn="OIDC / OAuth2 over HTTPS", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3.MiddlewarepoolAZ3.Signinggatewayreplica3.EthereumHSMsigninggateway_1, ProductionthreeAZ.Azureregionselectionpending.RegionalnetworkingandAKScontrol.BesuRPCroutingservice, "Forwards reads and submits eth_sendRawTransaction", $techn="JSON-RPC / private TLS", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone1.MiddlewarepoolAZ1.RecoverycontrollercandidateAZ1.Fencedrecoverycontroller_1, ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.MicrosoftEntraID, "Obtains scoped credentials for fencing and recovery", $techn="Workload Identity / HTTPS", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone2.MiddlewarepoolAZ2.RecoverycontrollercandidateAZ2.Fencedrecoverycontroller_1, ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.MicrosoftEntraID, "Obtains scoped credentials for fencing and recovery", $techn="Workload Identity / HTTPS", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.PrivateAKSclusteronemember.AvailabilityZone3.MiddlewarepoolAZ3.RecoverycontrollercandidateAZ3.Fencedrecoverycontroller_1, ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.MicrosoftEntraID, "Obtains scoped credentials for fencing and recovery", $techn="Workload Identity / HTTPS", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.KeyVaultPremium, ProductionthreeAZ.Azureregionselectionpending.ManagedpersistenceoutsideAKS.Protectedrecoverystorage, "Stores protected key and secret recovery artifacts", $techn="Controlled backup job", $tags="", $link="")
Rel(ProductionthreeAZ.Azureregionselectionpending.AzurekeyservicesoutsideAKS.ValidatorHSMclusterGATEH1, ProductionthreeAZ.Azureregionselectionpending.ManagedpersistenceoutsideAKS.Protectedrecoverystorage, "Exports vendor-protected recovery material after qualification", $techn="Encrypted HSM backup", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml