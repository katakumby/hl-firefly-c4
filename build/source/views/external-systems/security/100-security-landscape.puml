Rel(MicrosoftActiveDirectoryFederationServices, MicrosoftActiveDirectoryDomainServices, "Requests domain authentication and account attributes", $techn="Kerberos / protected directory access", $tags="", $link="")
Rel(Memberapplicationreference, Keycloak, "Requests application sign-in and identity claims", $techn="HTTPS / OIDC or SAML reference flow", $tags="", $link="")
Rel(Memberapplicationreference, MicrosoftEntraID, "Requests application sign-in and identity claims", $techn="HTTPS / OIDC or SAML reference flow", $tags="", $link="")
Rel(Memberapplicationreference, MicrosoftActiveDirectoryFederationServices, "Requests application sign-in and identity claims", $techn="HTTPS / OIDC or SAML reference flow", $tags="", $link="")
