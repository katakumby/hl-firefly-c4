Rel(Securityadministrator, CyberArkConjurEnterprise, "Configures CyberArk Conjur Enterprise access policy and reviews administrative outcomes", $techn="HTTPS / product administration interface", $tags="", $link="")
Rel(Securityadministrator, MicrosoftEntraID, "Configures Microsoft Entra ID access policy and reviews administrative outcomes", $techn="HTTPS / product administration interface", $tags="", $link="")
Rel(Securityadministrator, MicrosoftActiveDirectoryDomainServices, "Configures Microsoft Active Directory Domain Services access policy and reviews administrative outcomes", $techn="Protected LDAP / directory administration", $tags="", $link="")
Rel(Securityadministrator, MicrosoftActiveDirectoryFederationServices, "Configures Microsoft Active Directory Federation Services access policy and reviews administrative outcomes", $techn="AD FS administration / PowerShell", $tags="", $link="")
Rel(Businessuser, Keycloak, "Completes user sign-in through browser-mediated authentication", $techn="HTTPS / user browser", $tags="", $link="")
Rel(Businessuser, MicrosoftEntraID, "Completes user sign-in through browser-mediated authentication", $techn="HTTPS / user browser", $tags="", $link="")
Rel(Businessuser, MicrosoftActiveDirectoryFederationServices, "Completes user sign-in through browser-mediated authentication", $techn="HTTPS / user browser", $tags="", $link="")
Rel(Businessuser, MicrosoftActiveDirectoryDomainServices, "Requests domain sign-in and service tickets through the domain client", $techn="Kerberos", $tags="", $link="")
