@startuml
title <size:24>Component - CardanoConnect: operations</size>\n<size:24>Component - CardanoConnect: operations</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System(Cardanonetwork, "Cardano network", $descr="External Cardano ledger accessed through Blockfrost or node-to-client protocols.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/README.md")
System(BlockfrostAPI, "Blockfrost API", $descr="Hosted or self-managed Cardano ledger API; alternative to direct node access.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/README.md")

System_Boundary("HyperledgerFireFly_boundary", "Hyperledger FireFly", $tags="") {
  Container_Boundary("HyperledgerFireFly.CardanoConnect_boundary", "CardanoConnect", $tags="") {
    Component(HyperledgerFireFly.CardanoConnect.HTTPandWebSocketAPI, "HTTP and WebSocket API", $techn="Rust", $descr="Routes transaction, contract, operation and stream requests.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/firefly-cardanoconnect/src/routes")
    Component(HyperledgerFireFly.CardanoConnect.Operationsmanager, "Operations manager", $techn="Rust", $descr="Coordinates transaction construction, signing and submission.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/firefly-cardanoconnect/src/operations")
    Component(HyperledgerFireFly.CardanoConnect.Blockchainclient, "Blockchain client", $techn="Rust", $descr="Selects Blockfrost or direct node-to-client ledger access.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/firefly-cardanoconnect/src/blockchain")
    Component(HyperledgerFireFly.CardanoConnect.Blockfrostadapter, "Blockfrost adapter", $techn="Rust", $descr="Reads chain data and submits transactions through Blockfrost.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/firefly-cardanoconnect/src/blockchain/blockfrost")
    Component(HyperledgerFireFly.CardanoConnect.Nodetoclientadapter, "Node-to-client adapter", $techn="Rust", $descr="Reads local node state and chain synchronization through Pallas.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/firefly-cardanoconnect/src/blockchain/n2c")
    Component(HyperledgerFireFly.CardanoConnect.Signerserviceclient, "Signer service client", $techn="Rust", $descr="Obtains transaction witnesses from the separate signer.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/firefly-cardanoconnect/src/signer.rs")
    Component(HyperledgerFireFly.CardanoConnect.SQLitepersistence, "SQLite persistence", $techn="Rust", $descr="Persists operations, checkpoints and contract key-value state.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/firefly-cardanoconnect/src/persistence")
    Component(HyperledgerFireFly.CardanoConnect.SharedHTTPserverandinstrumentation, "Shared HTTP server and instrumentation", $techn="Rust", $descr="Hosts routes, configuration and tracing; an embedded library.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/firefly-server/src")
  }

  ContainerDb(HyperledgerFireFly.CardanoConnectSQLitefiles, "CardanoConnect SQLite files", $techn="SQLite / filesystem", $descr="Operation, checkpoint and optional contract worker state.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/firefly-cardanoconnect/src/persistence")
  Container(HyperledgerFireFly.CardanoSigner, "Cardano Signer", $techn="Rust / Axum", $descr="Signs CBOR transaction bodies using separately stored Cardano keys.", $tags="", $link="https://github.com/hyperledger-firefly/cardano/tree/0300bca6b0b99d2a16a81b94f65496934999346e/firefly-cardanosigner")
  Container(HyperledgerFireFly.FireFlyCore, "FireFly Core", $techn="Go", $descr="Exposes member APIs, serves Explorer assets and orchestrates multiparty operations.", $tags="", $link="https://github.com/hyperledger-firefly/firefly/tree/9d20f3081c9074d5b012427e5572ebc03da8d95d/internal/orchestrator")
}

Rel(HyperledgerFireFly.CardanoConnect.Blockfrostadapter, BlockfrostAPI, "Queries blocks and submits signed transactions", $techn="HTTPS / Blockfrost API", $tags="", $link="")
Rel(HyperledgerFireFly.CardanoConnect.Nodetoclientadapter, Cardanonetwork, "Synchronizes chain and queries ledger state", $techn="Cardano node-to-client / local socket", $tags="", $link="")
Rel(HyperledgerFireFly.CardanoConnect.SharedHTTPserverandinstrumentation, HyperledgerFireFly.CardanoConnect.HTTPandWebSocketAPI, "Hosts connector HTTP and WebSocket routes", $techn="In-process calls / Rust", $tags="", $link="")
Rel(HyperledgerFireFly.CardanoConnect.HTTPandWebSocketAPI, HyperledgerFireFly.CardanoConnect.Operationsmanager, "Submits operation requests", $techn="In-process calls / Rust", $tags="", $link="")
Rel(HyperledgerFireFly.CardanoConnect.Operationsmanager, HyperledgerFireFly.CardanoConnect.Blockchainclient, "Builds and submits ledger transactions", $techn="In-process calls / Rust", $tags="", $link="")
Rel(HyperledgerFireFly.CardanoConnect.Blockchainclient, HyperledgerFireFly.CardanoConnect.Blockfrostadapter, "Dispatches requests when Blockfrost is configured", $techn="In-process calls / Rust", $tags="", $link="")
Rel(HyperledgerFireFly.CardanoConnect.Blockchainclient, HyperledgerFireFly.CardanoConnect.Nodetoclientadapter, "Dispatches requests when direct node access is configured", $techn="In-process calls / Rust", $tags="", $link="")
Rel(HyperledgerFireFly.CardanoConnect.Operationsmanager, HyperledgerFireFly.CardanoConnect.Signerserviceclient, "Requests transaction witnesses", $techn="In-process calls / Rust", $tags="", $link="")
Rel(HyperledgerFireFly.CardanoConnect.Operationsmanager, HyperledgerFireFly.CardanoConnect.SQLitepersistence, "Persists operation lifecycle state", $techn="In-process calls / Rust", $tags="", $link="")
Rel(HyperledgerFireFly.CardanoConnect.Signerserviceclient, HyperledgerFireFly.CardanoSigner, "Requests transaction witnesses", $techn="HTTP / JSON", $tags="", $link="")
Rel(HyperledgerFireFly.CardanoConnect.SQLitepersistence, HyperledgerFireFly.CardanoConnectSQLitefiles, "Reads and writes operation and checkpoint records", $techn="SQLite API / filesystem", $tags="", $link="")
Rel(HyperledgerFireFly.FireFlyCore, HyperledgerFireFly.CardanoConnect.HTTPandWebSocketAPI, "Submits configured ledger requests", $techn="HTTP REST / JSON", $tags="", $link="")
Rel(BlockfrostAPI, Cardanonetwork, "Reads the ledger and relays submitted transactions", $techn="Cardano integration / service boundary", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml